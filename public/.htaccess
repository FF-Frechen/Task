Options -Indexes
DirectoryIndex index.php

# Versteckte Dateien (.htaccess, .git …) nie ausliefern
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  <Files "manifest.json">
    ForceType application/manifest+json
  </Files>
  AddType image/svg+xml .svg
</IfModule>

# Statische Dateien dürfen gecacht werden (Version steht in der URL)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png)$">
    Header set Cache-Control "public, max-age=604800"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
